@{
    ViewBag.Title = "Análisis de Datos";
    Layout = "_Layout";
}

@section Estilos {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@@tabler/icons-webfont@@2.47.0/tabler-icons.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/themes/dark.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css">
    <link rel="stylesheet" href="~/css/AnalisisDatos.css?v=6.2" />
}

<div id="ad-root" class="ad-wrap py-4">

    <!-- ================= FILTROS ================= -->
    <div class="ad-card ad-filters p-3 mb-3">

        <!-- Período plegable: resumen compacto; al tocarlo se despliegan los chips de Rápido / Año / Mes -->
        <div id="ad-pp" class="ad-pp">
        <div class="ad-filters__row ad-pp__bar">
            <div class="ad-filters__label"><i class="ti ti-calendar-event"></i> Período</div>
            <button type="button" id="ad-pp-toggle" class="ad-pp__toggle" aria-expanded="false" aria-controls="ad-pp-body">
                <span class="chip active ad-pp__actual" id="ad-pp-actual">—</span>
                <span class="ad-pp__cambiar"><i class="ti ti-adjustments-horizontal"></i> <span class="ad-pp__txt">Cambiar período</span> <i class="ti ti-chevron-down ad-pp__chev"></i></span>
            </button>
        </div>
        <div id="ad-pp-body" class="ad-pp__body" role="region" aria-label="Elegir período">
        <div class="ad-pp__inner">

        <div class="ad-filters__row">
            <div class="ad-filters__label"><i class="ti ti-bolt"></i> Rápido</div>
            <div id="ad-chips-quick" class="ad-chips">
                <button class="chip" data-preset="hoy">Hoy</button>
                <button class="chip" data-preset="7">7 días</button>
                <button class="chip" data-preset="30">30 días</button>
                <button class="chip" data-preset="90">90 días</button>
                <button class="chip" data-preset="mes">Este mes</button>
                <button class="chip" data-preset="mesAnt">Mes anterior</button>
                <button class="chip" data-preset="ytd">Año a la fecha</button>
                <button class="chip" data-preset="365">Últimos 12 meses</button>
                <button class="chip" data-preset="todo">Todo</button>
            </div>
        </div>

        <div class="ad-filters__row">
            <div class="ad-filters__label"><i class="ti ti-calendar-stats"></i> Año</div>
            <div id="ad-chips-year" class="ad-chips"></div>
        </div>

        <div class="ad-filters__row">
            <div class="ad-filters__label"><i class="ti ti-calendar-month"></i> Mes</div>
            <div id="ad-chips-month" class="ad-chips"></div>
            <span class="ad-hint">Shift + clic para elegir varios meses</span>
        </div>

        </div>
        </div>
        </div>

        <div class="ad-filters__row ad-filters__row--inputs">
            <div class="ad-filter">
                <div class="ad-filter__label">Rango personalizado</div>
                <input id="ad-flatpickr" class="ad-input" placeholder="Elegí un rango…" readonly />
            </div>
            <div class="ad-filter">
                <div class="ad-filter__label">Cliente</div>
                <select id="filtroCliente" class="ad-input"></select>
            </div>
            <div class="ad-filter">
                <div class="ad-filter__label">Forma de pago</div>
                <select id="filtroFormaPago" class="ad-input" style="min-width:190px"></select>
            </div>
            <div class="ad-filter">
                <div class="ad-filter__label">Top productos</div>
                <input id="filtroTopN" type="number" value="15" min="3" max="100" class="ad-input" style="width:100px">
            </div>
            <div class="ad-filters__actions">
                <button id="btnConsultar" class="ad-btn-primary"><i class="ti ti-refresh me-1"></i> Actualizar</button>
                <button id="btnExportar" class="ad-btn-ghost"><i class="ti ti-file-type-pdf me-1"></i> PDF</button>
            </div>
        </div>

        <div id="ad-periodo" class="ad-periodo"></div>
    </div>

    <!-- ================= TABS ================= -->
    <div class="ad-tabs" id="ad-tabs">
        <button class="ad-tab active" data-tab="resumen"><i class="ti ti-layout-dashboard"></i> Resumen</button>
        <button class="ad-tab" data-tab="ventas"><i class="ti ti-receipt-2"></i> Ventas</button>
        <button class="ad-tab" data-tab="productos"><i class="ti ti-armchair"></i> Productos</button>
        <button class="ad-tab" data-tab="gastos"><i class="ti ti-wallet"></i> Gastos</button>
    </div>

    <div id="ad-error" class="ad-alert" hidden></div>

    <!-- ================= RESUMEN ================= -->
    <section class="ad-pane" id="pane-resumen">

        <div id="ad-kpis" class="ad-kpi-grid"></div>

        <div class="row g-3 mt-1">
            <div class="col-xl-5">
                <div class="ad-card p-3 h-100">
                    <div class="ad-card__header">¿A dónde va lo que cobro? <span class="ad-sub">de ventas cobradas a resultado</span></div>
                    <div class="ad-chart ad-chart--md"><canvas id="ch_cascada"></canvas></div>
                </div>
            </div>
            <div class="col-xl-7">
                <div class="ad-card p-3 h-100">
                    <div class="ad-card__header">Evolución <span class="ad-sub" id="ad-evo-sub"></span></div>
                    <div class="ad-chart ad-chart--md"><canvas id="ch_evolucion"></canvas></div>
                </div>
            </div>
        </div>

        <div class="row g-3 mt-1">
            <div class="col-12">
                <div class="ad-card p-3">
                    <div class="ad-card__header">Resumen mensual <span class="ad-sub">como la planilla · clic en un mes para verlo</span></div>
                    <div id="tbl_mensual"></div>
                </div>
            </div>
        </div>

        <div class="row g-3 mt-1">
            <div class="col-xl-6">
                <div class="ad-card p-3 h-100">
                    <div class="ad-card__header">Medios de pago</div>
                    <div class="ad-chart ad-chart--sm"><canvas id="ch_medios"></canvas></div>
                    <div id="tbl_medios" class="mt-2"></div>
                </div>
            </div>
            <div class="col-xl-6">
                <div class="ad-card p-3 h-100">
                    <div class="ad-card__header">Composición de lo cobrado <span class="ad-sub">ganancia neta + IVA + costo financiero</span></div>
                    <div class="ad-chart ad-chart--md"><canvas id="ch_composicion"></canvas></div>
                </div>
            </div>
        </div>

        <div class="row g-3 mt-1">
            <div class="col-xl-8">
                <div class="ad-card p-3 h-100">
                    <div class="ad-card__header">Comparativa interanual <span class="ad-sub">ventas vs mismo mes del año anterior</span></div>
                    <div class="ad-chart ad-chart--md"><canvas id="ch_interanual"></canvas></div>
                </div>
            </div>
            <div class="col-xl-4">
                <div class="ad-card p-3 h-100">
                    <div class="ad-card__header">Ventas por día de la semana</div>
                    <div class="ad-chart ad-chart--md"><canvas id="ch_diasemana"></canvas></div>
                </div>
            </div>
        </div>

        <div class="row g-3 mt-1">
            <div class="col-12">
                <div class="ad-card p-3">
                    <div class="ad-card__header">Mejores clientes <span class="ad-sub">clic en un cliente para filtrar</span></div>
                    <div id="tbl_clientes"></div>
                </div>
            </div>
        </div>    </section>

    <!-- ================= VENTAS ================= -->
    <section class="ad-pane" id="pane-ventas" hidden>
        <div class="ad-card p-3">
            <div class="ad-card__header">
                Detalle de ventas
                <span class="ad-sub">mismas fórmulas que el Excel · clic en una fila para ver los productos</span>
            </div>
            <div id="ventas-chips" class="ad-chips mb-2"></div>
            <div id="tbl_ventas"></div>
        </div>
    </section>

    <!-- ================= PRODUCTOS ================= -->
    <section class="ad-pane" id="pane-productos" hidden>
        <div class="ad-card p-3">
            <div class="ad-card__header d-flex flex-wrap align-items-center justify-content-between gap-2">
                <span>Ranking de productos <span class="ad-sub" id="ad-prod-sub"></span></span>
                <span class="ad-seg" id="prod-orden">
                    <button class="ad-seg__btn active" data-orden="mas">Más</button>
                    <button class="ad-seg__btn" data-orden="menos">Menos</button>
                </span>
            </div>
            <div class="ad-chips mb-2" id="prod-metricas">
                <button class="chip active" data-metric="Unidades">Unidades vendidas</button>
                <button class="chip" data-metric="Ingreso">Ingresos</button>
                <button class="chip" data-metric="Margen">Margen $</button>
                <button class="chip" data-metric="MargenPct">Margen %</button>
                <button class="chip" data-metric="Pedidos">Veces vendido</button>
            </div>
            <div class="ad-chart ad-chart--tall"><canvas id="ch_productos"></canvas></div>
        </div>

        <div class="row g-3 mt-1">
            <div class="col-xl-5">
                <div class="ad-card p-3 h-100">
                    <div class="ad-card__header">Rentabilidad por categoría</div>
                    <div class="ad-chart ad-chart--md"><canvas id="ch_categoria"></canvas></div>
                </div>
            </div>
            <div class="col-xl-7">
                <div class="ad-card p-3 h-100">
                    <div class="ad-card__header">Mapa de productos <span class="ad-sub">unidades vs margen % (tamaño = ingreso)</span></div>
                    <div class="ad-chart ad-chart--md"><canvas id="ch_burbujas"></canvas></div>
                </div>
            </div>
        </div>

        <div class="ad-card p-3 mt-3">
            <div class="ad-card__header">Todos los productos vendidos</div>
            <div id="tbl_productos"></div>
        </div>
    </section>

    <!-- ================= GASTOS ================= -->
    <section class="ad-pane" id="pane-gastos" hidden>
        <div class="row g-3">
            <div class="col-xl-5">
                <div class="ad-card p-3 h-100">
                    <div class="ad-card__header">Gastos por categoría <span class="ad-sub">neto</span></div>
                    <div class="ad-chart ad-chart--tall"><canvas id="ch_gastoscat"></canvas></div>
                </div>
            </div>
            <div class="col-xl-7">
                <div class="ad-card p-3 h-100">
                    <div class="ad-card__header">Insumos vs operativos por mes <span class="ad-sub">neto</span></div>
                    <div class="ad-chart ad-chart--tall"><canvas id="ch_gastosmes"></canvas></div>
                </div>
            </div>
        </div>
        <div class="ad-card p-3 mt-3">
            <div class="ad-card__header">
                Detalle de gastos <span class="ad-sub">mismas fórmulas que el Excel (transferencia: importe ÷ 1,21)</span>
            </div>
            <div id="gastos-chips" class="ad-chips mb-2"></div>
            <div id="tbl_gastos"></div>
        </div>
    </section>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
    <script src="https://cdn.jsdelivr.net/npm/flatpickr/dist/l10n/es.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>

    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.3"></script>
    <script src="https://cdn.jsdelivr.net/npm/html2canvas@1.4.1/dist/html2canvas.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jspdf@2.5.1/dist/jspdf.umd.min.js"></script>

    <script src="~/js/AnalisisDatos.js?v=6.1"></script>
}
